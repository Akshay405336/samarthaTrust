# PostgreSQL Database Connection URL
# Replace placeholders with your actual PostgreSQL credentials
DATABASE_URL="postgresql://postgres:password@localhost:5432/samartha_trust?schema=public"

# Next.js Application Environment
NEXT_PUBLIC_APP_NAME="Samartha Trust"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Super Admin Initial Credentials (Used during prisma db seed)
# Used only when running 'pnpm db:seed' to create the initial Super Admin account
SUPER_ADMIN_EMAIL="admin@samarthatrust.org"
SUPER_ADMIN_NAME="Samartha Trust Super Admin"
SUPER_ADMIN_PASSWORD="YourStrongPasswordHere_Min8Chars!"

# Authentication & Session Secrets
# Generate a cryptographically secure random string of at least 32 characters
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="your-cryptographically-secure-random-secret-at-least-32-chars-long"
